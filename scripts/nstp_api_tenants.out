[]},{"name":"Strativ Tech (Pvt) Ltd","url":"https://strativ.io","logo":"https://portal.nstp.pk/api/internal/files/prod/logos/36ed5fbf-bd2b-486a-bfc5-d41ec8cbbbfc.png?token=2d05538c76ec0d65894fa09d8378b356055628092c609b57f41d281f87023f48&expires=1789421149","aboutCompany":"Strativ is an IT services and Software Development company, specializing in web and mobile apps development, CRMs, ERPs and management systems, quality assurance and other related services.\nOur products include CallsignGPT (https://callsigngpt.com) and VanWaala.\nStrativ is also working in partnership with Intelligent Inference, working on bringing Pakistan's own AI Inference platform.","companyDisplayEmail":"contact@strativ.io","floor":"","offices":[]},{"name":"CubeX LMS","url":"https://www.cubexlms.com","logo":"https://portal.nstp.pk/api/internal/files/prod/logos/02a394b9-8cfd-4825-9b93-3b2314379974.png?token=b7c342f361cba3456ab68f88c8104cd085ce3d9ae6fbea36cec4c3005c26ce4a&expires=1789421149","aboutCompany":"","companyDisplayEmail":"cubexlms@gmail.com","floor":"","offices":[]},{"name":"refactr","url":"https://www.refactr.net/","logo":"https://portal.nstp.pk/api/internal/files/prod/logos/37aab682-a2cd-4c63-835f-cbe677359b35.png?token=38e3fcad69002b6bb2ad4c464efc6e6ed9496423268a98f7fc27b31bbb23affc&expires=1789421149","aboutCompany":"Building AI Stack for Private Intelligence","companyDisplayEmail":"rameel@refactr.net","floor":"","offices":[]},{"name":"EcoMuhafiz","url":"","logo":"https://portal.nstp.pk/api/internal/files/prod/logos/9442f9ac-9500-4656-b78a-86516ab54853.jpeg?token=4b849a3624c9cae1917ed7cd157bc4c18d02fe6d19de8a254444ddd9a4592ca3&expires=1789421149","aboutCompany":"","companyDisplayEmail":"","floor":"","offices":[]},{"name":"Bio Pixel","url":"bpixel.netlify.app","logo":"https://portal.nstp.pk/api/internal/files/prod/logos/c7fc98f4-04eb-4c21-9ef0-aa937ebf0ff8.png?token=bf44a0d65b20048a6bb5a6a94b91f763c153c4bc4e26d1aa8799c848f823fe7f&expires=1789421149","aboutCompany":"","companyDisplayEmail":"","floor":"","offices":[]},{"name":"Letseetech","url":"https://www.flowdoc.dev/","logo":"https://portal.nstp.pk/api/internal/files/prod/logos/ad5cf84e-a8a4-4be6-b528-ae1250f8cc54.png?token=cb98b160d867437c622a89ea36e1994c967aebca2952fc6c8721c4f11e60a920&expires=1789421149","aboutCompany":"","companyDisplayEmail":"flowdoc.dev@gmail.com","floor":"","offices":[]},{"name":"Edvay","url":"","logo":"https://portal.nstp.pk/api/internal/files/prod/logos/c6b7794d-cdbc-4999-85bf-d7134ebd9444.jpeg?token=13da1f3c297bc5d232780dd22af9cb3c46bdd2294983f34ec6e27c82262fd432&expires=1789421149","aboutCompany":"","companyDisplayEmail":"","floor":"","offices":[]},{"name":"Network Defence System (NDS)","url":"https://nds-main.vercel.app/","logo":"https://portal.nstp.pk/api/internal/files/prod/logos/a0eaedb7-38fa-45d0-aa0a-4768ff0675c0.jpeg?token=196796923a0b4efcbc52888aa45320ebf9700cdea9a81d902c2fe85b328a9877&expires=1789421149","aboutCompany":"","companyDisplayEmail":"nds.security.official@gmail.com","floor":"","offices":[]},{"name":"WhiteHat Design Studio","url":"","logo":"https://portal.nstp.pk/api/internal/files/prod/logos/e50456d0-dd00-43cf-aaff-ca7ed77b059b.jpeg?token=39b6ab7153be3ffcbddf85aa759ba1aede456dff1dcdcadde7b0a502cc8b9334&expires=1789421149","aboutCompany":"","companyDisplayEmail":"","floor":"","offices":[]},{"name":"Spatiaxr","url":"https://spatiaxr.com/","logo":"https://portal.nstp.pk/api/internal/files/prod/logos/4639935d-2330-4834-a20f-e3f3e118a633.png?token=edffcdb1dee33dd77503999c19a1f73fdc9a402c27b6499f6b009ea93bc657b1&expires=1789421149","aboutCompany":"","companyDisplayEmail":"","floor":"","offices":[]},{"name":"Proxis","url":"","logo":"https://portal.nstp.pk/api/internal/files/prod/logos/a19abe53-010f-4f70-9fc6-fb532c1d62fb.jpeg?token=5350b4b78b6ffcd8312e7b037988528dbfd1d5f2a47fa5883ff745b245a13359&expires=1789421149","aboutCompany":"","companyDisplayEmail":"","floor":"","offices":[]},{"name":"Himmat Stride","url":"https://www.linkedin.com/company/himmat-stride","logo":"https://portal.nstp.pk/api/internal/files/prod/logos/6c723774-07f3-4ea0-bf63-28e726c0867e.png?token=276f97e0c5ebc885c38137978cd9e0f8514f5500af718012fad165506b5fa109&expires=1789421149","aboutCompany":"We are building a wearable solution to monitor the motion characteristics, to improve the gait and increase the efficiency. ","companyDisplayEmail":"himmatstride@gmail.com","floor":"","offices":[]},{"name":"Awaaz Labs","url":"","logo":"https://portal.nstp.pk/api/internal/files/prod/logos/ddc09e4e-8f3f-4d19-9b02-eafefdb5412e.png?token=9c741bfa52d7cfa0cf45c27b3644769007942818c76f6dddee30d1ab0bfef05a&expires=1789421149","aboutCompany":"","companyDisplayEmail":"","floor":"","offices":[]},{"name":"WBRAINS - Web Bot Recognition and Instant Notification System","url":"https://wbrains.vercel.app/","logo":"https://portal.nstp.pk/api/internal/files/prod/logos/7139ece0-b995-4e75-9e3d-eb7e502bec14.png?token=660e5bfa1c7e5fd7fdc7fa12f6b953ed9d3db15ea37833ffb7cbfff62baef2bd&expires=1789421149","aboutCompany":"Bots now make up over 50% of all internet traffic; costing businesses $48 billion a year. Enterprise solutions to fight them cost $5,000+/month. That leaves small and mid-sized businesses completely exposed.\n\nWBRAINS changes that.\n\nWe are a cybersecurity middleware that detects and neutralises automated bot threats in real time, without ever disrupting your real users. No intrusive CAPTCHAs. No false alarms. Just silent, intelligent protection running in the background.\n\nOur hybrid detection engine combines rule-based heuristics with an XGBoost machine learning classifier trained on 11 behavioural features; including mouse movement entropy, click dwell time, and inter-request timing. Each session receives a live risk score, and our system responds in (allow, block, rate limit, captcha).\n\nKey Capabilities:\n→ Behavioral Biometrics: Analysis of user interaction patterns to identify non-human signatures.\n→ Hybrid Detection Engine: A multi-layered approach combining machine learning with advanced heuristic rules.\n→ Instant Notification System: Real-time administrative alerts for immediate threat response and mitigation.","companyDisplayEmail":"wbrains.detection@gmail.com","floor":"","offices":[]},{"name":"XORYN","url":"","logo":"https://portal.nstp.pk/api/internal/files/prod/logos/8571ab1c-95b0-43dd-930f-f52a26427ab2.jpeg?token=b4ba428a0afb2b81ff16bbf3028dceb5f3c3e9a6c6d7353ad4f01678a1450a11&expires=1789421149","aboutCompany":"XORYN is a deep-tech engineering platform reimagining the semiconductor design workflow. Built specifically for silicon architects and hardware engineers, XORYN replaces fragmented, legacy EDA tool interactions with a unified, intelligence-driven development environment. By deeply understanding hardware description languages (HDLs), architectural constraints, and verification paradigms, XORYN accelerates the journey from high-level specification to tape-out, serving as the core infrastructure for next-generation compute architecture.","companyDisplayEmail":"","floor":"","offices":[]},{"name":"QueryPilot","url":"usequerypilot.com","logo":"https://portal.nstp.pk/api/internal/files/prod/logos/44d44a57-06a6-416c-87e4-c8b6a211b7ae.png?token=fb5465e82df63f62126856684f43af96f7219b1548a17d9fed3a235531cbbba5&expires=1789421149","aboutCompany":"QueryPilot is a secure AI database assistant that lets developers manage databases using plain English. It runs entirely on the user's computer, ensuring sensitive company data stays completely private and never leaves the machine.","companyDisplayEmail":"ahmedshahmeer486@gmail.com","floor":"","offices":[]},{"name":"CraveLab","url":"https://tinyurl.com/cravelab","logo":"https://portal.nstp.pk/api/internal/files/prod/logos/ff45d211-7585-4cd1-8798-f70f57bdf85b.png?token=63a86b1c9f2b9e3e77872a9f38f2fcd12e93f4f0a925030144dca3710613dbd0&expires=1789421149","aboutCompany":"","companyDisplayEmail":"teamcravelab@gmail.com","floor":"","offices":[]},{"name":"Invoy","url":"","logo":"https://portal.nstp.pk/api/internal/files/prod/logos/433c330e-ffa0-4cb8-9764-bde7fcf8d18c.jpeg?token=fe5be612a48feffe6ec03aace7a5d5e09b33ca566523d9da2db3e77bec43976a&expires=1789421149","aboutCompany":"","companyDisplayEmail":"","floor":"","offices":[]},{"name":"Testly","url":"","logo":"https://portal.nstp.pk/api/internal/files/prod/logos/f5bf0dba-2490-45ab-b6dd-dd6c8b272ecf.jpeg?token=518cca94ec52c6993f3c3b0003670713e638ed3cea018d1f96c6e2971bc717df&expires=1789421149","aboutCompany":"","companyDisplayEmail":"","floor":"","offices":[]},{"name":"HRXpert- Automating Talent acquisition using Artificial Intelligence","url":"https://hrxpert.website","logo":"https://portal.nstp.pk/api/internal/files/prod/logos/1ccf471b-539f-4a65-b303-0a45ae2249dc.jpeg?token=ccb5f0d96ab168d326a398833bc708f3035227a4913243e00eb8b4cebb3ed15f&expires=1789421149","aboutCompany":"","companyDisplayEmail":"hrxpert.ai@gmail.com","floor":"","offices":[]},{"name":"AgroFibe","url":"","logo":"https://portal.nstp.pk/api/internal/files/prod/logos/49e1233c-54a8-4043-bf99-1da3f51bb5c1.png?token=935d3c2188c8181d678e501024cd3c811f4a70bf9139a8805ccb07da843427c0&expires=1789421149","aboutCompany":"AgroFibe is a sustainable materials startup dedicated to transforming agricultural waste, primarily rice straw, into high-quality particle boards for the furniture and construction industries. By converting crop residue into durable engineered boards, AgroFibe helps reduce crop burning, minimize environmental pollution, and decrease dependence on timber. Our mission is to drive the circular economy by turning agricultural waste into innovative, eco-friendly building materials that create value for farmers, manufacturers, and the environment.","companyDisplayEmail":"","floor":"","offices":[]},{"name":"Viora ","url":"","logo":"https://portal.nstp.pk/api/internal/files/prod/logos/445e7eae-1d11-4170-aa9f-371d1c582183.jpeg?token=f853e484c9b0f7f8f8ce42bbf1ff434f7381d2c94a91a91fad0663fe3be0f3ff&expires=1789421149",