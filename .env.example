# ── Database ─────────────────────────────────────────────────────────
DATABASE_URL="file:./db/custom.db"

# ── Outgoing email (verification codes & password resets) ────────────
# Cortex needs ONE of the two options below to send real emails.
# Full walkthrough: EMAIL-SETUP.md
#
# Option A — Resend (easiest, ~2 minutes):
#   1. Create a free account at https://resend.com → API Keys → Create
#   2. Uncomment and fill in:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
#
# Option B — Gmail SMTP (needs a 16-character App Password, NOT your
# normal Gmail password):
#   1. https://myaccount.google.com/security → turn on 2-Step Verification
#   2. https://myaccount.google.com/apppasswords → create one
#   3. Uncomment and fill in:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
#
# Optional display name/sender override:
# MAIL_FROM="Cortex <onboarding@resend.dev>"
#
# Local development only — shows the code in the UI when delivery is
# impossible. NEVER enable this on a server other people can reach.
# AUTH_DEV_CODE_FALLBACK=true
