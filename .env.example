# ── Database ─────────────────────────────────────────────────────────
# Local dev / VPS (SQLite file) — still works with the disk-storage fallback:
# DATABASE_URL="file:./db/custom.db"
#
# Serverless (Vercel + Neon Postgres) — use Neon's POOLED connection string,
# with pgbouncer=true appended (required by Prisma behind a transaction-mode
# pooler). Schema is pushed with: DATABASE_URL="<direct url>" npx prisma db push
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# ── Auth ─────────────────────────────────────────────────────────────
# Required in production: signs session cookies. Generate with: openssl rand -hex 32
# AUTH_SECRET=""

# ── AI (summaries, doc Q&A, mindmaps, flashcards) ────────────────────
# Any OpenAI-compatible provider. Groq is free and fast:
# OPENAI_API_KEY="gsk_xxxxxxxxxxxxxxxx"
# OPENAI_BASE_URL="https://api.groq.com/openai/v1"
# AI_MODEL="llama-3.3-70b-versatile"

# ── PDF storage ──────────────────────────────────────────────────────
# On Vercel: connect a Blob store in the project's Storage tab and Vercel
# injects BLOB_READ_WRITE_TOKEN automatically — PDFs then upload directly
# from the browser to Blob (no request-size cap). Without it (local/VPS)
# PDFs fall back to streaming to the local uploads/ directory.

# ── Outgoing email (verification codes & password resets) ────────────
# Cortex needs ONE of the two options below to send real emails.
# Full walkthrough: EMAIL-SETUP.md
#
# Option A — Resend (easiest, ~2 minutes):
#   1. Create a free account at https://resend.com → API Keys → Create
#   2. Uncomment and fill in:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
#
# Option B — Gmail SMTP (needs a 16-character App Password, NOT your
# normal Gmail password):
#   1. https://myaccount.google.com/security → turn on 2-Step Verification
#   2. https://myaccount.google.com/apppasswords → create one
#   3. Uncomment and fill in:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop
#
# Optional display name/sender override:
# MAIL_FROM="Cortex <onboarding@resend.dev>"
#
# Local development only — shows the code in the UI when delivery is
# impossible. NEVER enable this on a server other people can reach.
# AUTH_DEV_CODE_FALLBACK=true
