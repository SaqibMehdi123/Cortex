# ── Database ─────────────────────────────────────────────────────────
# Local dev / VPS (SQLite file) — still works with the disk-storage fallback:
# DATABASE_URL="file:./db/custom.db"
#
# Serverless (Vercel + Neon Postgres) — use Neon's POOLED connection string,
# with pgbouncer=true appended (required by Prisma behind a transaction-mode
# pooler). Schema is pushed with: DATABASE_URL="<direct url>" npx prisma db push
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# ── Auth ─────────────────────────────────────────────────────────────
# Required in production: signs session cookies. Generate with: openssl rand -hex 32
# AUTH_SECRET=""

# ── AI (summaries, doc Q&A, mindmaps, flashcards) ────────────────────
# Any OpenAI-compatible provider. Groq is free and fast:
# OPENAI_API_KEY="gsk_xxxxxxxxxxxxxxxx"
# OPENAI_BASE_URL="https://api.groq.com/openai/v1"
# AI_MODEL="llama-3.3-70b-versatile"

# ── PDF storage ──────────────────────────────────────────────────────
# Three backends, picked automatically from what is configured:
#
# 1) Cloudflare R2 (recommended — 10 GB free, zero egress fees, no Vercel
#    upload gateway involved). Set ALL FOUR and uploads switch to R2:
# R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxx
# R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# R2_BUCKET=cortex-pdfs
#    One-time console setup (bucket + token + CORS): docs/R2-SETUP.md
#    Live check after deploying: GET /api/ops/health → "r2" section
#
# 2) Vercel Blob — active when only the Blob token is present. On Vercel:
#    connect a Blob store in the project's Storage tab and Vercel injects
#    BLOB_READ_WRITE_TOKEN automatically.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxx
#
# 3) Local disk (uploads/) — when neither is set. Local dev / VPS only.

# ── Crons (two scheduled jobs, both CRON_SECRET-hardened) ─────────────
# vercel.json schedules:
#   GET /api/cron/morning  daily 04:00 UTC (09:00 Asia/Karachi) — briefing mail
#   GET /api/cron/feeds    daily 03:30 UTC (08:30 PKT) — scholarship & exchange
#                          programme sync fanned out to every verified account
# Vercel signs each call with "Authorization: Bearer $CRON_SECRET" when this is
# set — generate with:
#   openssl rand -hex 32
# Without it the scheduler's x-vercel-cron header is accepted as a weaker
# fallback (set the secret to harden). Test by hand:
#   curl "https://<app>/api/cron/morning?key=$CRON_SECRET&dryRun=1"
#   curl "https://<app>/api/cron/feeds?key=$CRON_SECRET&dryRun=1"
# CRON_SECRET=""

# ── Outgoing email (verification codes, password resets, morning mail) ──
# Cortex tries providers in this order: Resend → SendGrid → SMTP → Brevo.
# Full walkthrough: EMAIL-SETUP.md  ·  Live check: GET /api/ops/health
#
# Sender identity on the scrutinies.dev domain (after Cloudflare Email Routing
# creates the mailboxes and the Gmail send-as is verified):
#   MAIL_FROM="Cortex <hello@scrutinies.dev>"
# Resend variant (once the domain is verified in Resend):
#   RESEND_FROM="Cortex <hello@scrutinies.dev>"
# Every mail carries Reply-To: support@scrutinies.dev (override: MAIL_REPLY_TO).
#
# Option A — SendGrid (recommended, 100 emails/day free, NO IP allow-list):
#   1. Create a free account at https://signup.sendgrid.com
#   2. Verify a sender: Settings → Sender Authentication → Verify a Single
#      Sender → click the confirmation link SendGrid emails you
#      (no custom domain needed — use your own address, e.g. you@gmail.com)
#   3. Settings → API Keys → Create API Key ("Full Access" is fine for a
#      personal app; "Restricted Access" must include Mail Send)
#   4. Uncomment and fill in:
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
# SENDGRID_SENDER_EMAIL=you@gmail.com
#
# Option B — any SMTP provider (SMTP2GO free 1,000/mo, Postmark, Gmail …):
#   1. Create an account at https://www.smtp2go.com (or your SMTP provider)
#   2. Verify the sender address they ask for
#   3. Uncomment and fill in (SMTP2GO: username/password from their dashboard):
# SMTP_HOST=mail.smtp2go.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=you
# SMTP_PASS=xxxxxxxx
#
# Legacy — Brevo (kept as automatic last-resort fallback; its Authorised-IPs
# feature can block serverless egress IPs, which is why it was demoted):
# BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxx
# BREVO_SENDER_EMAIL=you@gmail.com
#
# Optional display name / sender override (RFC form):
# MAIL_FROM="Cortex <you@gmail.com>"
#
# Local development only — shows the code in the UI when delivery is
# impossible. NEVER enable this on a server other people can reach.
# AUTH_DEV_CODE_FALLBACK=true

# ── Billing (Pro plan skeleton) ──────────────────────────────────────
# The pricing page (/pricing) POSTs to /api/billing/checkout, which routes to
# the first CONFIGURED provider in each geo's priority list:
#   Pakistan visitors  → Safepay (PKR: cards, JazzCash, Easypaisa, bank)
#                        → Polar → Lemon Squeezy
#   everyone else      → Polar (Merchant of Record, USD, tax handled)
#                        → Lemon Squeezy → Safepay
# With NOTHING below configured, checkout answers 501 and the UI shows
# "launching soon" — safe to deploy before you have any provider account.
# Full walkthrough for the primary provider: POLAR-SETUP.md
#
# Polar (polar.sh → Settings → API token with checkouts:write):
# POLAR_ACCESS_TOKEN=pat_xxxxxxxxxxxx     # or org token — from Settings → API
# POLAR_PRODUCT_ID_MONTHLY=xxxxxxxx       # "Cortex Pro — Monthly" product id
# POLAR_PRODUCT_ID_ANNUAL=xxxxxxxx        # "Cortex Pro — Annual" ($50/yr);
#                                         # omit → annual shows "launching soon"
# POLAR_MODE=live                         # "sandbox" for the sandbox org
# Webhook (Polar dashboard → Settings → Webhooks → Add endpoint, format Raw):
#   URL   https://cortex.scrutinies.dev/api/billing/webhook/polar
#   Events: order created / paid / refunded · subscription created / active /
#           updated / canceled / revoked
# POLAR_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx # shown once at endpoint creation
#
# Lemon Squeezy (lemonsqueezy.com → Stores → Cortex Pro, monthly variant):
# LEMONSQUEEZY_API_KEY=api_xxxxxxxxxxxx
# LEMONSQUEEZY_STORE_ID=123456
# LEMONSQUEEZY_VARIANT_ID=987654          # the Pro monthly variant id
# LEMONSQUEEZY_ANNUAL_VARIANT_ID=987655   # the Pro annual variant id ($50/yr);
#                                         # omit → annual shows "launching soon"
# Webhook (LS dashboard → Settings → Webhooks):
#   URL   https://cortex.scrutinies.dev/api/billing/webhook/lemonsqueezy
#   Events: order created · subscription created / payment success /
#           payment failed / cancelled / expired
# LEMONSQUEEZY_WEBHOOK_SECRET=<openssl rand -hex 32 — same value in LS dashboard>
#
# Safepay (getsafepay.com dashboard → Developers):
# SAFEPAY_SECRET_KEY=ss_pk_xxxxxxxxxxxx
# SAFEPAY_MODE=sandbox                    # "live" when approved
# SAFEPAY_WEBHOOK_SECRET=<from the dashboard webhook section>
#
# Local UI testing with no providers at all (returns a fake checkout URL):
# BILLING_TEST_MODE=true                  # DEV ONLY — fake checkout url + emails
#                                         # a SAMPLE receipt to your own address
#                                         # (onboarding evidence for payment
#                                         # providers). Turn OFF right after.
