generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Knowledge Hub ─────────────────────────────────────────────────

model Document {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  author         String?
  type           String           @default("article") // article | paper | book | url | text | newsletter | other
  source         String?
  notes          String?
  content        String?
  filePath       String? // original PDF — a Vercel Blob URL (serverless) or a uploads/<id>.pdf disk name (VPS/dev) — rendered in the embedded viewer
  fileName       String?
  fileSize       Int?
  pageCount      Int?
  status         String           @default("reading") // queued | reading | finished | paused
  progress       Int              @default(0) // 0-100
  lastPage       Int? // last PDF page the reader was on (book resume position)
  tags           String? // comma separated
  summary        String?
  takeaways      String? // JSON array of strings
  shelfId        String? // shelf this book sits on — null = loose in the library
  shelf          Shelf?           @relation(fields: [shelfId], references: [id], onDelete: SetNull)
  lastReadAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  highlights     Highlight[]
  chatMessages   ChatMessage[]
  flashcards     Flashcard[]
  readingSessions ReadingSession[]

  @@index([shelfId])
}

// A named shelf in the Library — books (Documents) are placed on exactly one
// shelf at a time. Deleting a shelf leaves its books unshelved (SetNull).
model Shelf {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  position  Int        @default(0) // left-to-right order on the bookcase
  createdAt DateTime   @default(now())
  documents Document[]

  @@index([userId])
}

model Highlight {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String
  document   Document    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  text       String
  color      String      @default("yellow") // yellow | green | blue | pink
  note       String?
  position   Int         @default(0) // approximate char offset in content
  createdAt  DateTime    @default(now())
  flashcards Flashcard[]
}

model ChatMessage {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  thread     String    @default("copilot") // "copilot" | "doc:<documentId>"
  role       String // user | assistant
  content    String
  citations  String? // JSON [{n, label, documentId?, url?}]
  createdAt  DateTime  @default(now())
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  content   String
  source    String   @default("typed") // typed | voice | url | capture
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Planning & Goal Engine ────────────────────────────────────────

model Goal {
  id              String         @id @default(cuid())
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  category        String         @default("learning") // career | learning | health | personal | project
  deadline        DateTime?
  status          String         @default("active") // active | completed | paused
  color           String         @default("indigo") // indigo | emerald | amber | rose | violet | cyan
  streak          Int            @default(0)
  lastCompletedAt DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  milestones      Milestone[]
  plans           Plan[]
  mindmaps        MindMap[]
  tasks           Task[]
  focusSessions   FocusSession[]
}

model Milestone {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId      String
  goal        Goal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  title       String
  done        Boolean   @default(false)
  dueDate     DateTime?
  order       Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  tasks       Task[]
}

model Task {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  status       String         @default("todo") // todo | doing | done
  priority     String         @default("med") // low | med | high
  dueDate      DateTime?
  estimate     Int            @default(30) // estimated minutes
  focusMinutes Int            @default(0)
  order        Int            @default(0)
  milestoneId  String?
  milestone    Milestone?     @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  goalId       String?
  goal         Goal?          @relation(fields: [goalId], references: [id], onDelete: Cascade)
  planId       String?
  plan         Plan?          @relation(fields: [planId], references: [id], onDelete: Cascade)
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  focusSessions FocusSession[]
}

model Plan {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  timeframe String    @default("day") // year | quarter | month | week | day
  title     String
  notes     String?
  startDate DateTime?
  endDate   DateTime?
  done      Boolean   @default(false)
  goalId    String?
  goal      Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  parentId  String?
  parent    Plan?     @relation("PlanTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Plan[]    @relation("PlanTree")
  tasks     Task[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Reminder {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  recurrence String    @default("once") // once | daily | weekly | monthly | yearly
  startDate  DateTime // anchor day — UTC midnight of the picked calendar day
  showDays   Int       @default(1) // each occurrence stays visible for N consecutive days
  lastDoneAt DateTime? // completion marker — hides the current occurrence only (recurring-safe)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, startDate])
}

// ─── AI News Radar ─────────────────────────────────────────────────

model NewsArticle {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  source      String?
  url         String
  summary     String?
  category    String    @default("company") // company | research | lab | newsletter | blog
  publishedAt DateTime?
  read        Boolean   @default(false)
  saved       Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@unique([userId, url])
}

model CustomSource {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  url       String
  type      String   @default("blog") // blog | newsletter | x | company | lab
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
}

// Research papers tracked from Hugging Face Daily Papers & arXiv
model Paper {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  arxivId     String
  title       String
  authors     String? // comma separated
  abstract    String?
  url         String?
  pdfUrl      String?
  source      String    @default("huggingface") // huggingface | arxiv
  upvotes     Int       @default(0)
  publishedAt DateTime?
  // AI analysis (structured)
  tldr        String?
  problem     String?
  innovation  String?
  results     String? // JSON array of key results / numbers
  whyMatters  String?
  analyzedAt  DateTime?
  saved       Boolean   @default(false)
  documentId  String? // set when saved into the Library
  createdAt   DateTime  @default(now())

  @@unique([userId, arxivId])
}

// ─── Career Command Center ─────────────────────────────────────────

model Opportunity {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     String
  role        String
  type        String    @default("internship") // internship | job | research | scholarship | event | referral
  classification String @default("opportunity") // opportunity | rejection | interview | offer | deadline
  sender      String?
  source      String?
  url         String?
  location    String?
  status      String    @default("saved") // saved | applied | interview | offer | rejected | archived
  deadline    DateTime?
  nextAction  String?
  resume      String? // resume/CV version linked to this application
  notes       String?
  gmailId     String? // Gmail message id when imported via OAuth
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, gmailId])
}

// ─── Mindmap Studio ────────────────────────────────────────────────

// Fetched job/internship/research listings from authentic external sources.
// Saved listings get copied into the Opportunity pipeline.
model JobListing {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  company     String
  role        String
  roleFamily  String?   // research | engineering | data | product | design | gtm | ops | other — role-group filter for Discover
  type        String    @default("job") // job | internship | research
  location    String?
  source      String
  url         String
  externalId  String?
  publishedAt DateTime?
  saved       Boolean   @default(false)
  fetchedAt   DateTime  @default(now())

  @@unique([userId, url])
  @@index([type])
  @@index([roleFamily])
  @@index([source])
}

// Masters/PhD scholarships & fully-funded opportunities, pulled from curated
// scholarship RSS feeds into each account's own private list (per-user dedupe
// + saved state), following the same hybrid auto-sync contract as news.
model Scholarship {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  provider  String // feed/site the opportunity came from
  url       String
  level     String    @default("other") // masters | phd | other
  country   String? // best-effort host-country extraction from the title
  funding   String? // "Fully funded" | "Funded" | "… stipend"
  summary   String? // RSS content snippet
  source    String // feed key: scholarshipscorner | fullyfundedscholarships | opportunitydesk
  saved     Boolean   @default(false)
  fetchedAt DateTime  @default(now())
  createdAt DateTime  @default(now())

  @@unique([userId, url])
  @@index([level])
  @@index([userId, saved])
}

model MindMap {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  goalId      String?
  goal        Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  nodes       String   @default("[]") // JSON [{id,label,x,y,parentId,color,linkType?,linkId?,linkUrl?}]
  sourceDocId String? // document this map was AI-generated from — one map per document (dedup)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sourceDocId])
}

// ─── Spaced repetition ─────────────────────────────────────────────

model Flashcard {
  id             String      @id @default(cuid())
  userId         String
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  front          String
  back           String
  documentId     String?
  document       Document?   @relation(fields: [documentId], references: [id], onDelete: SetNull)
  highlightId    String?
  highlight      Highlight?  @relation(fields: [highlightId], references: [id], onDelete: SetNull)
  ease           Float       @default(2.5)
  interval       Float       @default(0) // days
  repetitions    Int         @default(0)
  lapses         Int         @default(0)
  dueAt          DateTime    @default(now())
  lastReviewedAt DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  reviews        ReviewLog[]
}

model ReviewLog {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  flashcardId String
  flashcard  Flashcard @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  grade      String // again | hard | good | easy
  reviewedAt DateTime  @default(now())
}

// ─── Analytics & focus ─────────────────────────────────────────────

model ReadingSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  minutes    Int
  day        DateTime // midnight of the day
  createdAt  DateTime @default(now())
}

model FocusSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  task      Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  goalId    String?
  goal      Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  minutes   Int
  startedAt DateTime  @default(now())
  endedAt   DateTime?
}

// ─── Accounts & auth ────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  passwordHash  String // pbkdf2$iterations$salt$hash (Web Crypto, no native deps)
  emailVerified Boolean  @default(false) // new signups verify via a 6-digit email code
  lastNewsFetchAt DateTime? // last successful RSS pull — drives auto-refresh (empty/stale > 3h triggers a background fetch)
  lastPapersFetchAt DateTime? // same hybrid auto-sync contract, for the papers feed
  lastJobsFetchAt DateTime? // same hybrid auto-sync contract, for the jobs discover board
  lastScholarshipsFetchAt DateTime? // same hybrid auto-sync contract, for masters/PhD scholarships
  createdAt     DateTime @default(now())

  documents         Document[]
  shelves           Shelf[]
  highlights        Highlight[]
  chatMessages      ChatMessage[]
  notes             Note[]
  goals             Goal[]
  milestones        Milestone[]
  tasks             Task[]
  plans             Plan[]
  reminders         Reminder[]
  newsArticles      NewsArticle[]
  customSources     CustomSource[]
  papers            Paper[]
  opportunities     Opportunity[]
  jobListings       JobListing[]
  mindmaps          MindMap[]
  flashcards        Flashcard[]
  reviewLogs        ReviewLog[]
  readingSessions   ReadingSession[]
  focusSessions     FocusSession[]
  setting           Setting?
  verificationCodes VerificationCode[]
  scholarships      Scholarship[]
}

// 6-digit verification codes (email verification & password reset).
// Only a salted/peppered SHA-256 hash of the code is stored — never the code.
model VerificationCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   String // 'email_verify' | 'password_reset'
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int       @default(0) // invalid after 5 wrong entries
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
}

// ─── Workspace settings ────────────────────────────────────────────

// Per-user workspace preferences (one row per account).
model Setting {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String   @default("there")
  theme       String   @default("system") // light | dark | system
  digestTime  String   @default("08:00") // daily digest delivery time
  googleAuth  String? // JSON {access_token, refresh_token, expiry_date, scope}
  googleEmail String?
  updatedAt   DateTime @updatedAt
}
